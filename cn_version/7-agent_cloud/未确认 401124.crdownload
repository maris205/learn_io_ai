      "\n",
      "需要我帮你部署某个配置吗？\n"
     ]
    }
   ],
   "source": [
    "answer = await agent_chat('帮我看看有哪些 GPU 硬件可以用，最便宜的是哪个？', tools)"
   ]
  },
